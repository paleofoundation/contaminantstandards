{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.contaminantstandards\\.com"
        }
      ],
      "destination": "https://contaminantstandards.com/:path*",
      "statusCode": 308
    }
  ]
}
